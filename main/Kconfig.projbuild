menu "WiFi Configuration"

    config WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) for the WiFi network to connect to.

    config WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            Password for the WiFi network.

    config WIFI_MAXIMUM_RETRY
        int "Maximum WiFi Retry Count"
        default 10
        help
            Maximum number of retry attempts before giving up on WiFi connection.

    config WIFI_SCAN_AUTH_MODE_THRESHOLD
        int "WiFi Scan Auth Mode Threshold"
        default 0
        help
            WiFi Authentication Mode threshold (0=OPEN, 1=WEP, 2=WPA_PSK, 3=WPA2_PSK, 4=WPA_WPA2_PSK).
            Use 0 (OPEN) to accept any authentication mode from the AP.

    config WIFI_PREFER_NVS
        bool "Prefer NVS WiFi credentials over Kconfig (for config-tool deployment)"
        default n
        help
            When enabled, WiFi credentials saved in NVS (namespace "devcfg",
            injected by config-tool / sensor-setup-py) take priority. If NVS
            has no saved credentials, the build-time CONFIG_WIFI_SSID/PASSWORD
            values are used as a fallback.

            - n (default): flash/monitor development build — always use Kconfig
              values (independent of NVS; config-tool has no effect).
            - y: customer deployment build — NVS first, Kconfig fallback, so the
              provisioning tool can set WiFi per-device without rebuilding.

endmenu

menu "Status LED Configuration"

    config STATUS_LED_WS2812
        bool "Status LED is a WS2812 addressable RGB LED (DevKit style)"
        default n
        help
            n (default): discrete 3-pin RGB LED on GPIOs (customer sensor module,
                         same pinout as UV1: R=8, G=3, B=46).
            y          : WS2812 RGB LED driven via led_strip (ESP32-S3-DevKitC, GPIO48).

    config STATUS_LED_GPIO
        int "WS2812 data GPIO"
        depends on STATUS_LED_WS2812
        default 48

    config STATUS_LED_RED_GPIO
        int "RGB LED red GPIO"
        depends on !STATUS_LED_WS2812
        default 8

    config STATUS_LED_GREEN_GPIO
        int "RGB LED green GPIO"
        depends on !STATUS_LED_WS2812
        default 3

    config STATUS_LED_BLUE_GPIO
        int "RGB LED blue GPIO"
        depends on !STATUS_LED_WS2812
        default 46

    config STATUS_LED_ACTIVE_LOW
        bool "RGB LED turns ON when GPIO is LOW (common anode)"
        depends on !STATUS_LED_WS2812
        default y
        help
            Customer module measured: GPIO8 LOW -> red ON. GPIO46 defaults LOW at
            reset (strapping pull-down), which is why blue is on right after power-up.

endmenu

menu "Serial Streaming (USB direct) Configuration"

    choice STREAM_SERIAL_CHANNEL
        prompt "Serial streaming output channel"
        default STREAM_SERIAL_CHANNEL_UART0
        help
            transport=2 (USB 직결) 일 때 진동 데이터를 내보낼 물리 채널.

            보드 배선에 따라 반드시 맞춰야 한다. 틀리면 설정은 주입되지만
            데이터가 어디에도 도달하지 않아 원인 찾기 어려운 고장으로 보인다.

            판별 방법 — 보드를 PC/라즈베리파이에 꽂고 lsusb 확인:
              · 303a:xxxx (Espressif) 로 잡히면  → USB_JTAG
              · 04b4/10c4/1a86/0403 등 브리지칩 → UART0

        config STREAM_SERIAL_CHANNEL_UART0
            bool "UART0 (USB-UART 브리지 경유)"
            help
                보드의 USB 커넥터가 USB-UART 브리지(CP210x/CH340/FTDI/Cypress 등)로
                이어지는 경우. 콘솔과 같은 UART0 를 쓰므로 스트리밍 중 로그는 차단된다.

                실제 UART 라 보드레이트가 속도를 직접 제한한다:
                  115200 → 약 1 kHz / 230400 → 3.3 kHz
                  921600 → 13.3 kHz / 2000000 → 26.6 kHz

        config STREAM_SERIAL_CHANNEL_USB_JTAG
            bool "USB Serial/JTAG (ESP32-S3 내장 USB)"
            help
                보드의 USB 커넥터가 ESP32-S3 내장 USB(GPIO19/20)에 직결된 경우.
                USB CDC 라 보드레이트가 형식적 값이며 26.6 kHz 까지 여유가 있다.
    endchoice

    config STREAM_SERIAL_UART_BAUD
        int "UART0 streaming baud rate"
        depends on STREAM_SERIAL_CHANNEL_UART0
        default 921600
        help
            시리얼 스트리밍 중에만 적용되는 UART0 보드레이트.
            스트리밍 시작 시 이 값으로 올리고, 정지 시 콘솔 기본값으로 되돌린다.

            플래시·부팅로그는 항상 115200 이므로 esptool 동작에는 영향이 없다.
            수신 프로그램(rpi-receiver/serial_receiver.py)의 --baud 와 반드시 같아야 한다.

            브리지칩이 지원하는 상한을 넘기면 데이터가 깨진다. 보드에서 실측한
            값을 쓸 것.

    config STREAM_DIAG_INT_PIN
        bool "INT 핀 전기 상태 진단 로그 (문제 추적용)"
        default n
        help
            스트리밍 시작 시 INT1/INT2 핀에 내부 풀업·풀다운을 번갈아 걸어
            레벨을 읽고, 신호가 오지 않는 것인지(단선/미구동) LOW 로 능동
            구동되는 것인지(극성 반전) 판정해 로그로 남긴다.

            센서가 watermark 도달(FIFO_STATUS2 의 WTM=1)인데도 ESP32 핀이
            LOW 로 읽히는 상황을 가를 때 쓴다. 평소에는 꺼 둔다.

            대조군으로 함께 읽는 INT2 핀은 CONFIG_IIS3DWB_INT2_GPIO 를 쓴다
            (핀 정의는 components/iis3dwb/Kconfig 한 곳에만 둔다).

endmenu

# IIS3DWB 센서 핀·전체스케일·대역폭 설정은 components/iis3dwb/Kconfig 로 옮겼다.
# 전용 보드 검사 펌웨어(boardcheck/)와 핀맵을 한 곳에서 공유하기 위함이다.
# menuconfig 에서는 Component config → IIS3DWB Vibration Sensor Configuration.
