# IIS3DWB 배포 패키지(설정툴·수집기 공용) — udev 규칙
# 설치 위치: /etc/udev/rules.d/70-iis3dwb.rules  (install.sh 가 복사한다)
#
# 세 가지 일을 한다.
#
# [1] ModemManager 가 센서 포트를 건드리지 않게 한다.
#     ModemManager 는 새로 나타난 ttyACM 을 모뎀으로 의심해 AT 명령을 쏜다.
#     그 과정에서 USB-UART 브리지의 bulk OUT 엔드포인트가 스톨되면
#     읽기는 되는데 쓰기만 영구 블로킹되어 esptool 이 "Write timeout" 으로 죽는다.
#
# [2] /dev/bus/usb/* 를 plugdev 그룹이 쓸 수 있게 한다.
#     스톨 복구는 USBDEVFS_RESET ioctl 이 필요한데, 기본 권한(root:root 0664)에서는
#     sudo 가 필요하다. GUI 가 비밀번호를 묻지 않아야 하므로 그룹 쓰기를 허용한다.
#     (드라이버 unbind/rebind 로는 엔드포인트 상태가 초기화되지 않아 복구되지 않는다)
#
# [3] 화면 앞에 로그인한 사용자에게 바로 권한을 준다 (TAG+="uaccess").
#     dialout·plugdev·gpio 그룹은 추가해도 **재로그인 전까지** 적용되지 않아,
#     처음 실행이 반드시 "권한 없음" 으로 실패했다. uaccess 는 systemd-logind 가
#     현재 데스크톱 세션 사용자에게 ACL 을 붙이는 방식이라 즉시 적용된다.
#     SSH 세션에는 적용되지 않으므로 그룹은 그대로 함께 쓴다 (install.sh).
#
#     ⚠ 파일 번호가 73 보다 작아야 한다. uaccess 태그는 73-seat-late.rules 가
#     ACL 로 바꾸는데, 그보다 뒤(예전 이름 99-iis3dwb.rules)에서 붙이면 무시된다.
#     개발 RPi 에서는 apt 의 esptool·openocd 규칙이 같은 ACL 을 붙여 주고 있어
#     이 차이가 드러나지 않는다 — 현장 RPi 에는 그 패키지들이 없다.

# ---- Cypress USB-UART 브리지 (이 센서 보드) ----
SUBSYSTEM=="usb", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="0003", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="0003", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"

# ---- Espressif 내장 USB Serial/JTAG (네이티브 USB 포트가 있는 보드) ----
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"

# ---- 흔한 USB-UART 브리지 (CP210x / CH340 / FTDI) ----
SUBSYSTEM=="usb", ATTRS{idVendor}=="10c4", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev", TAG+="uaccess"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="uaccess"

# ---- 포토센서 입력 (수집기) — /dev/gpiochip* ----
# Raspberry Pi OS 는 root:gpio 0660 으로 만든다. 그룹은 그대로 두고 ACL 만 더한다.
SUBSYSTEM=="gpio", KERNEL=="gpiochip*", TAG+="uaccess"
