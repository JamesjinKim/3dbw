# IIS3DWB 센서 설정툴 — udev 규칙
# 설치 위치: /etc/udev/rules.d/99-iis3dwb.rules  (install.sh 가 복사한다)
#
# 두 가지 일을 한다.
#
# [1] ModemManager 가 센서 포트를 건드리지 않게 한다.
#     ModemManager 는 새로 나타난 ttyACM 을 모뎀으로 의심해 AT 명령을 쏜다.
#     그 과정에서 USB-UART 브리지의 bulk OUT 엔드포인트가 스톨되면
#     읽기는 되는데 쓰기만 영구 블로킹되어 esptool 이 "Write timeout" 으로 죽는다.
#
# [2] /dev/bus/usb/* 를 plugdev 그룹이 쓸 수 있게 한다.
#     스톨 복구는 USBDEVFS_RESET ioctl 이 필요한데, 기본 권한(root:root 0664)에서는
#     sudo 가 필요하다. GUI 가 비밀번호를 묻지 않아야 하므로 그룹 쓰기를 허용한다.
#     (드라이버 unbind/rebind 로는 엔드포인트 상태가 초기화되지 않아 복구되지 않는다)

# ---- Cypress USB-UART 브리지 (이 센서 보드) ----
SUBSYSTEM=="usb", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="0003", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="tty", ATTRS{idVendor}=="04b4", ATTRS{idProduct}=="0003", ENV{ID_MM_DEVICE_IGNORE}="1"

# ---- Espressif 내장 USB Serial/JTAG (네이티브 USB 포트가 있는 보드) ----
SUBSYSTEM=="usb", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ENV{ID_MM_DEVICE_IGNORE}="1"

# ---- 흔한 USB-UART 브리지 (CP210x / CH340 / FTDI) ----
SUBSYSTEM=="usb", ATTRS{idVendor}=="10c4", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1a86", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", ENV{ID_MM_DEVICE_IGNORE}="1", MODE="0660", GROUP="plugdev"
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ENV{ID_MM_DEVICE_IGNORE}="1"
